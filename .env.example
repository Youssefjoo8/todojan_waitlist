# ---------------------------------------------------------------------------
# Environment variables (ALL OPTIONAL)
#
# The app runs 100% locally with zero configuration. You do NOT need to copy
# this file to run `npm run dev`. It only exists to document the one optional
# setting below.
# ---------------------------------------------------------------------------

# Absolute base URL used for Open Graph / social preview metadata.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
